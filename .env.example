# Clube Gestor 360 — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com a URL do seu PocketBase
# O arquivo .env.local NÃO deve ser commitado no git

# PocketBase
# Opção gratuita: crie em https://pockethost.io → obtenha a URL do projeto
# Opção self-hosted: URL do seu VPS (ex: https://meuclube.com.br)
VITE_POCKETBASE_URL=https://xxxx.pockethost.io
